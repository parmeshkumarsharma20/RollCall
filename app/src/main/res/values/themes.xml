<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Light Theme for RollCall -->
    <style name="Base.Theme.RollCall" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/light_blue</item>
        <item name="colorOnPrimaryContainer">@color/primary_blue</item>
        <item name="colorSecondary">@color/dark_blue</item>
        <item name="colorTertiary">@color/yellow_accent</item>
        <item name="android:windowBackground">@color/blue_bg</item>
        <item name="android:statusBarColor">@color/dark_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.RollCall" parent="Base.Theme.RollCall" />
</resources>